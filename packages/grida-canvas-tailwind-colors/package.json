{
  "name": "@grida/tailwindcss-colors",
  "version": "4.0.1",
  "private": false,
  "description": "Tailwind CSS color data package - provides color values in multiple formats (RGBA, HEX, OKLCH) for programmatic use. Not intended for direct CSS import in production.",
  "keywords": [
    "colors",
    "data",
    "grida",
    "tailwind",
    "tailwindcss"
  ],
  "homepage": "https://grida.co",
  "license": "MIT",
  "author": "softmarshmallow",
  "repository": "https://github.com/gridaco/grida",
  "files": [
    "css",
    "json",
    "types.d.ts",
    "README.md"
  ],
  "exports": {
    "./css/rgb.css": "./css/rgb.css",
    "./css/rgba.css": "./css/rgba.css",
    "./css/hex.css": "./css/hex.css",
    "./css/oklch.css": "./css/oklch.css",
    "./json/rgb.json": {
      "import": {
        "types": "./json/rgb.json.d.ts",
        "default": "./json/rgb.json"
      },
      "require": {
        "types": "./json/rgb.json.d.cts",
        "default": "./json/rgb.json"
      }
    },
    "./json/rgbf.json": {
      "import": {
        "types": "./json/rgbf.json.d.ts",
        "default": "./json/rgbf.json"
      },
      "require": {
        "types": "./json/rgbf.json.d.cts",
        "default": "./json/rgbf.json"
      }
    },
    "./json/rgba.json": {
      "import": {
        "types": "./json/rgba.json.d.ts",
        "default": "./json/rgba.json"
      },
      "require": {
        "types": "./json/rgba.json.d.cts",
        "default": "./json/rgba.json"
      }
    },
    "./json/hex.json": {
      "import": {
        "default": "./json/hex.json",
        "types": "./json/hex.json.d.ts"
      },
      "require": {
        "default": "./json/hex.json",
        "types": "./json/hex.json.d.cts"
      }
    },
    "./json/oklch.json": {
      "import": {
        "types": "./json/oklch.json.d.ts",
        "default": "./json/oklch.json"
      },
      "require": {
        "types": "./json/oklch.json.d.cts",
        "default": "./json/oklch.json"
      }
    },
    "./types": {
      "types": "./types.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "deno run --allow-read --allow-write --allow-net --allow-env --no-prompt scripts/generate.ts",
    "prepublishOnly": "pnpm generate",
    "test": "node --test scripts/package.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^6"
  }
}
