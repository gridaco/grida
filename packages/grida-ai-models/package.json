{
  "name": "@grida/ai-models",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical AI model identities, provenance, provider bindings, capabilities, IO limits, and published prices. Product membership and preferences live in @app/ai-catalog.",
  "license": "MIT",
  "author": "Grida",
  "repository": "https://github.com/gridaco/grida",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6",
    "vitest": "^4"
  }
}
