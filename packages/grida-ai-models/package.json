{
  "name": "@grida/ai-models",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical AI model facts, with Grida service membership and preferences at @grida/ai-models/grida.",
  "license": "MIT",
  "author": "Grida",
  "repository": "https://github.com/gridaco/grida",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./grida": {
      "import": {
        "types": "./dist/grida.d.mts",
        "default": "./dist/grida.mjs"
      },
      "require": {
        "types": "./dist/grida.d.ts",
        "default": "./dist/grida.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "tsdown",
    "test": "vitest run",
    "test:package": "tsdown && node --test scripts/check-entries.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6",
    "vitest": "^4"
  }
}
