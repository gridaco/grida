{
  "name": "@app/ai-catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Grida service model membership, preferences, and compatible catalog distribution.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grida/ai-models": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6",
    "vitest": "^4"
  }
}
