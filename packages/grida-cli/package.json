{
  "name": "grida",
  "version": "0.4.0",
  "private": false,
  "description": "The Grida command line: account access and tools, independent of Desktop.",
  "homepage": "https://grida.co/docs/cli",
  "license": "Apache-2.0",
  "repository": "https://github.com/gridaco/grida",
  "bin": {
    "grida": "./native/bin.mjs"
  },
  "files": [
    "native/bin.mjs",
    "native/platforms.json",
    "native/licenses.json",
    "THIRD-PARTY-NOTICES.txt",
    "binaries"
  ],
  "type": "module",
  "scripts": {
    "build": "cargo build --manifest-path ../../Cargo.toml --locked --release -p grida-cli --bin grida",
    "test": "cargo test --manifest-path ../../Cargo.toml --locked -p grida-cli",
    "typecheck": "cargo check --manifest-path ../../Cargo.toml --locked -p grida-cli"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "grida_native": 2
}
