{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/ai/**",
        "$TURBO_ROOT$/scripts/ai-catalogue/**",
        "$TURBO_ROOT$/.oxfmtrc.jsonc"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/ai/**",
        "$TURBO_ROOT$/scripts/ai-catalogue/**",
        "$TURBO_ROOT$/.oxfmtrc.jsonc"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/ai/**",
        "$TURBO_ROOT$/scripts/ai-catalogue/**",
        "$TURBO_ROOT$/.oxfmtrc.jsonc"
      ]
    },
    "test:package": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/ai/**",
        "$TURBO_ROOT$/scripts/ai-catalogue/**",
        "$TURBO_ROOT$/.oxfmtrc.jsonc"
      ],
      "dependsOn": ["^build"]
    },
    "check:generated": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/data/ai/**",
        "$TURBO_ROOT$/scripts/ai-catalogue/**",
        "$TURBO_ROOT$/crates/grida-ai/data/**"
      ],
      "dependsOn": ["build"]
    },
    "generate": {
      "cache": false
    }
  }
}
