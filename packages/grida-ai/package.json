{
  "name": "@grida/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Shared model-driven operations and provider foundations, independent of host and application policy.",
  "license": "MIT",
  "author": "Grida",
  "repository": "https://github.com/gridaco/grida",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./providers": {
      "import": {
        "types": "./dist/providers.d.mts",
        "default": "./dist/providers.mjs"
      },
      "require": {
        "types": "./dist/providers.d.cts",
        "default": "./dist/providers.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:package": "node --test ../../scripts/ai-local/proof.test.mjs ../../scripts/npm.test.mjs && node ../../scripts/ai-local/proof.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.neutral.json"
  },
  "dependencies": {
    "@ai-sdk/gateway": "3.0.125",
    "@ai-sdk/provider": "3.0.10",
    "@grida/ai-models": "workspace:*",
    "ai": "6.0.197"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6",
    "vitest": "^4"
  }
}
