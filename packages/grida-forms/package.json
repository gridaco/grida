{
  "name": "@grida/forms",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Forms contracts, render models and pure domain utilities",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./templating": {
      "types": "./dist/templating.d.ts",
      "import": "./dist/templating.mjs",
      "require": "./dist/templating.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grida/tokens": "workspace:*",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "handlebars": "^4.7.9",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.8"
  }
}
