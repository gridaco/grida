{
  "name": "@grida/ai-host",
  "version": "0.0.0",
  "private": true,
  "description": "Retained Grida host services: shared media generation, provider credential custody, endpoint settings, the ChatGPT subscription transport and client-safe contracts. Native chat execution is owned by the native agent.",
  "license": "MIT",
  "author": "Grida",
  "repository": "https://github.com/gridaco/grida",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./media-server": {
      "import": {
        "types": "./dist/media-server.d.mts",
        "default": "./dist/media-server.mjs"
      },
      "require": {
        "types": "./dist/media-server.d.cts",
        "default": "./dist/media-server.cjs"
      }
    },
    "./chatgpt-host": {
      "import": {
        "types": "./dist/chatgpt-host.d.mts",
        "default": "./dist/chatgpt-host.mjs"
      },
      "require": {
        "types": "./dist/chatgpt-host.d.cts",
        "default": "./dist/chatgpt-host.cjs"
      }
    },
    "./media-transport": {
      "import": {
        "types": "./dist/media-transport.d.mts",
        "default": "./dist/media-transport.mjs"
      },
      "require": {
        "types": "./dist/media-transport.d.cts",
        "default": "./dist/media-transport.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.neutral.json"
  },
  "dependencies": {
    "@grida/ai": "workspace:*",
    "@grida/daemon": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6",
    "vitest": "^4"
  }
}
