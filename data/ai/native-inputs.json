    "allOf": [
      {
        "if": {
          "properties": {
            "resolution": {
              "const": "1280x720"
            }
          },
          "required": ["resolution"]
        },
        "then": {
          "properties": {
            "aspect_ratio": {
              "const": "16:9"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "resolution": {
              "const": "720x1280"
            }
          },
          "required": ["resolution"]
        },
        "then": {
          "properties": {
            "aspect_ratio": {
              "const": "9:16"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "resolution": {
              "const": "1920x1080"
            }
          },
          "required": ["resolution"]
        },
        "then": {
          "properties": {
            "aspect_ratio": {
              "const": "16:9"
            }
          }
        }
      },
      {
