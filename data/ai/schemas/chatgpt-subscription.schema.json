{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grida ChatGPT subscription model compatibility",
  "type": "object",
  "required": ["default_model_id", "retired_model_ids"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "default_model_id": {
      "type": "string",
      "pattern": "^openai/[A-Za-z0-9_.-]+$"
    },
    "retired_model_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^openai/[A-Za-z0-9_.-]+$"
      }
    }
  }
}
