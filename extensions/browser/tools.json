          "maxLength": 128
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "pageId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "kind": {
                  "const": "background"
                }
              },
              "required": ["kind", "pageId"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "tabId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "kind": {
                  "const": "workbench"
                }
              },
              "required": ["kind", "tabId"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["target", "documentId", "action"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "disposition": {
          "enum": ["not_dispatched", "dispatched_verified", "unknown"]
        },
        "error": {
          "type": "string"
        }
      },
      "required": ["disposition"]
    },
    "version": 1,
    "effect": "mutation"
  },
