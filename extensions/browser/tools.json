[
  {
    "name": "browser_action",
    "description": "Perform one click, fill, key press, select, hover, or scroll. Supply the target object and current documentId. For a click, set action to {\"kind\":\"click\",\"ref\":\"…\"} using a ref from the snapshot. Verify the result afterward.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "value": {
                  "type": "string",
                  "maxLength": 8192
                },
                "kind": {
                  "const": "fill"
                }
              },
              "required": ["kind", "ref", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "kind": {
                  "const": "click"
                }
              },
              "required": ["kind", "ref"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "point": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 32000
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 32000
                    },
                    "viewportId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": ["x", "y", "viewportId"],
                  "additionalProperties": false
                },
                "kind": {
                  "const": "click"
                }
              },
              "required": ["kind", "point"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "kind": {
                  "const": "hover"
                }
              },
              "required": ["kind", "ref"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "point": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 32000
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 32000
                    },
                    "viewportId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": ["x", "y", "viewportId"],
                  "additionalProperties": false
                },
                "kind": {
                  "const": "hover"
                }
              },
              "required": ["kind", "point"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "modifiers": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["Alt", "Control", "Meta", "Shift"]
                  }
                },
                "kind": {
                  "const": "press"
                }
              },
              "required": ["kind", "key"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "value": {
                  "type": "string",
                  "maxLength": 8192
                },
                "kind": {
                  "const": "select"
                }
              },
              "required": ["kind", "ref", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "deltaX": {
                  "type": "number",
                  "minimum": -12000,
                  "maximum": 12000
                },
                "deltaY": {
                  "type": "number",
                  "minimum": -12000,
                  "maximum": 12000
                },
                "point": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 32000
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 32000
                    },
                    "viewportId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": ["x", "y", "viewportId"],
                  "additionalProperties": false
                },
                "kind": {
                  "const": "scroll"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
